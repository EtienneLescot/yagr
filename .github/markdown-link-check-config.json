{
  "ignorePatterns": [
    { "pattern": "^https?://localhost" },
    { "pattern": "^https?://127.0.0.1" },
    { "pattern": "^mailto:" },
    { "pattern": "^#" },
    { "pattern": "^http://" }
  ],
  "replacementPatterns": [
    { "pattern": "^/", "replacement": "https://yagr.dev/" },
    { "pattern": "^docs/", "replacement": "https://yagr.dev/docs/" },
    { "pattern": "^api/", "replacement": "https://yagr.dev/api/" }
  ],
  "httpHeaders": [
    {
      "urls": ["https://yagr.dev"],
      "headers": { "Accept": "text/html" }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 403, 429]
}
