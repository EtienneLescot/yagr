{
  "name": "@yagr/session-service",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node --input-type=module --eval \"(await import('node:fs')).rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "pnpm --filter @yagr/session-checkpoint build && pnpm --filter @yagr/session-memory build && pnpm --filter @yagr/webui-session-registry build && node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint": "^1.0.1",
    "@yagr/session-checkpoint": "workspace:*",
    "@yagr/session-memory": "workspace:*",
    "@yagr/webui-session-registry": "workspace:*"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EtienneLescot/yagr.git"
  }
}
