{
  "name": "@yagr/agent",
  "version": "0.2.31-next.0",
  "description": "Autonomous local coding agent",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "bin": {
    "yagr": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:packages && npm run build:root",
    "build:root": "tsc -b && node scripts/build-webui.mjs",
    "build:packages": "node scripts/release/build-workspace-packages.mjs",
    "build:clean": "npm run clean && npm run build",
    "build:clean:symlink": "npm run clean && npm run build && node --eval \"import('fs').then(({chmodSync})=>chmodSync('dist/cli.js',0o755))\" && npm link",
    "clean": "node scripts/clean.mjs",
    "test": "npm run test:unit && npm run test:packages",
    "test:packages": "npm run test --workspace @yagr/plugin-runtime && npm run test --workspace @yagr/session-memory && npm run test --workspace @yagr/session-service && npm run test --workspace @yagr/impact-ledger && npm run test --workspace @yagr/reality-observer",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test:minimax-discovery": "npm run build && node scripts/test-minimax-discovery.mjs",
    "typecheck": "tsc --noEmit",
    "sync:brand-assets": "node scripts/sync-brand-assets.mjs",
    "yagr:onboard": "node --import ./scripts/env-yagr-test-workspace.mjs dist/cli.js onboard",
    "yagr:start": "node --import ./scripts/env-yagr-test-workspace.mjs dist/cli.js start",
    "yagr:gateway:status": "node --import ./scripts/env-yagr-test-workspace.mjs dist/cli.js gateway status",
    "yagr:test:workspace": "node scripts/yagr-test-workspace.mjs pwd",
    "yagr:test:init": "node scripts/yagr-test-workspace.mjs init",
    "yagr:test:agent": "node scripts/yagr-test-workspace.mjs agent",
    "release:plan": "node scripts/release/workspace-release.mjs stable-pr",
    "release:prepare": "node scripts/release/workspace-release.mjs stable-pr --apply",
    "release:prerelease": "node scripts/release/workspace-release.mjs prerelease",
    "release:prerelease:set-versions": "node scripts/release/set-workspace-prerelease-versions.mjs",
    "release:pending": "node scripts/release/workspace-release.mjs pending-stable",
    "deps:sync": "node scripts/release/sync-workspace-dependencies.mjs",
    "deps:check": "node scripts/release/sync-workspace-dependencies.mjs --check",
    "publish:stage": "node scripts/release/stage-workspace-packages.mjs",
    "publish:verify": "node scripts/release/verify-workspace-packages.mjs",
    "publish:workspace": "node scripts/release/publish-workspace-packages.mjs",
    "publish:workspace:next": "node scripts/release/publish-workspace-packages.mjs --tag next",
    "check-versions": "node scripts/check-version-consistency.js",
    "docs": "npm --prefix docs start",
    "docs:build": "npm --prefix docs run build",
    "update:snapshot": "node scripts/update-model-snapshot.mjs"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/langgraph": "^1.2.7",
    "@langchain/mistralai": "^1.0.7",
    "@langchain/openai": "^1.4.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@yagr/conversation-service": "file:packages/conversation-service",
    "@yagr/impact-ledger": "file:packages/impact-ledger",
    "@yagr/reality-observer": "file:packages/reality-observer",
    "@yagr/runtime-events": "file:packages/runtime-events",
    "@yagr/session-service": "file:packages/session-service",
    "@yagr/tui-surface": "file:packages/tui-surface",
    "conf": "^13.0.1",
    "deepagents": "^1.9.0",
    "dotenv": "^17.2.3",
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.8.0",
    "pacote": "^21.5.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "telegraf": "^4.16.3",
    "zod": "^3.22.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pacote": "^11.1.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.3",
    "testcontainers": "^11.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "yaml": "^2.8.3"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EtienneLescot/yagr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Etienne Lescot",
  "license": "MIT"
}
